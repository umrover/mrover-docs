---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { Icon } from '@astrojs/starlight/components';

// keep in sync with the sidebar groups in astro.config.mjs
// bolt and flask aren't Starlight icons, so they're inline svg
const sections = [
	{ name: 'Software', icon: 'laptop', blurb: 'Autonomy, Teleop, ESW, Drone' },
	{ name: 'Mechanical', icon: 'setting', blurb: 'Mobility, Chassis, Robotic Arm' },
	{ name: 'Electrical', svg: '<path fill="currentColor" d="M13 2 4 14h7l-1 8 9-12h-7z"/>', blurb: 'Power, Embedded Hardware, Communications' },
	{ name: 'Science', svg: '<path fill="none" stroke="currentColor" stroke-width="2" d="M9 3h6M10 3v6.2a6.1 6.1 0 1 0 4 0V3"/>', blurb: 'Science Payload, Astrobiology' },
] as const;
const current = sections.find((s) => Astro.url.pathname.startsWith(`/${s.name.toLowerCase()}`));
---

<div class="row">
	<Default />
	<details>
		<summary>
			{current && ('svg' in current ? <svg viewBox="0 0 24 24" set:html={current.svg} /> : <Icon name={current.icon} />)}
			{current?.name ?? 'Choose Section'} <Icon name="down-caret" class="caret" />
		</summary>
		<div class="menu">
			{sections.map((s) => (
				<a href={`/${s.name.toLowerCase()}/`} aria-current={s === current ? 'page' : undefined}>
					{'svg' in s ? <svg viewBox="0 0 24 24" set:html={s.svg} /> : <Icon name={s.icon} />}
					<span><b>{s.name}</b><small>{s.blurb}</small></span>
				</a>
			))}
		</div>
	</details>
</div>

<script>
	document.addEventListener('click', (e) => document.querySelectorAll('.row details').forEach((d) => d.contains(e.target as Node) || d.removeAttribute('open')));
</script>

<style>
	/* the header clips the title; let the menu hang below it */
	:global(.title-wrapper) { overflow: visible !important; }
	.row { display: flex; align-items: center; gap: 1rem; }
	details { position: relative; }
	/* search-box shape, site-title font */
	summary {
		display: flex; align-items: center; gap: 0.4rem; height: 2.5rem; padding-inline: 0.75rem;
		border: 2px solid var(--sl-color-gray-5); border-radius: 0.5rem; cursor: pointer;
		background: var(--sl-color-gray-6); color: var(--sl-color-gray-2);
		font-family: "Space Grotesk Variable", sans-serif; font-weight: 700; white-space: nowrap;
	}
	summary:hover, details[open] summary { border-color: var(--sl-color-gray-2); color: var(--sl-color-white); }
	summary::-webkit-details-marker { display: none; }
	.menu {
		position: absolute; top: calc(100% + 0.5rem); z-index: 10; width: 20rem; padding: 0.4rem;
		background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem; box-shadow: var(--sl-shadow-lg);
	}
	a { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; border-radius: 0.5rem; color: inherit; text-decoration: none; }
	a:hover, a[aria-current] { background: var(--sl-color-gray-6); }
	a svg, summary svg:not(.caret) { width: 1.25rem; height: 1.25rem; flex-shrink: 0; color: var(--sl-color-accent); }
	small { display: block; color: var(--sl-color-gray-3); }
	/* phones: just the pill, so search and the menu button still fit */
	@media (max-width: 50rem) { .row > :global(.site-title) { display: none; } }
</style>
